# Copy this file to .env and fill in your own secrets.
# Never commit backend/.env.

# Required: choose exactly one hosted LLM provider.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Required for live market research, competitor discovery, and source citations.
TAVILY_API_KEY=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
# Optional: configure fallback LLM providers only if you add their keys.
# LLM_FALLBACK_ORDER=groq,gemini,openai,ollama
# GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=replace_with_your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Optional: run entirely locally with Ollama instead of a hosted LLM key.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Optional local storage paths.
# MongoDB is the primary account-owned workspace store.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=autonomous_startup_builder
# SQLITE_PATH=./startup_builder.db
# CHROMA_PATH=./chroma_data
